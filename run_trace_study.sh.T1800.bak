#!/usr/bin/env bash
# Drives the Poisson-vs-Azure-trace study end to end.
#
#   run_trace_study.sh [MAXJOBS]
#
# Phase 0  trace_experiments.py       settings + cloned inputs + manifest
# Phase 1  selection_simulation.py    one pass per run, which creates
#                                     results/run_<N>/ and lets
#                                     resimulate_seeds.py accept the run
# Phase 2  resimulate_seeds.py        the ten paired request streams; the trace
#                                     window is picked from the seed, so the ten
#                                     streams are ten different real half-hours
# Phase 3  trace_table.py             paired differences, win counts, slopes
#
# placement.py is never called: the arrival process is a simulator input and
# every run clones a solved placement. Runs touch only their own parameter and
# result files, so the work splits across cores by run number.
set -u
cd "$(dirname "$0")"

PY=./.optifaasvenv/Scripts/python.exe
MANIFEST=settings/trace_campaign.json
MAXJOBS=${1:-9}
LOGDIR=logs/trace
mkdir -p "$LOGDIR"

RUNS=$(seq 640 648)

echo "== phase 0: generating the campaign =="
$PY trace_experiments.py || exit 1

echo "== phases 1+2: $(echo $RUNS | wc -w) runs x 10 streams on $MAXJOBS workers =="
worker() {
    local r="$1" log="$LOGDIR/run_$1.log"
    $PY selection_simulation.py --num_run=$r > "$log" 2>&1 || { echo "SIMFAIL $r" >> "$log"; return; }
    $PY resimulate_seeds.py --seeds=10 --manifest="$MANIFEST" --runs="$r" >> "$log" 2>&1 \
        || echo "SEEDFAIL $r" >> "$log"
}

for r in $RUNS; do
    worker "$r" &
    while [ "$(jobs -r | wc -l)" -ge "$MAXJOBS" ]; do wait -n; done
done
wait

fails=$(grep -l "SIMFAIL\|SEEDFAIL" "$LOGDIR"/run_*.log 2>/dev/null | wc -l)
echo "workers finished; logs with failures: $fails"

echo "== phase 3: table =="
$PY trace_table.py --latex
